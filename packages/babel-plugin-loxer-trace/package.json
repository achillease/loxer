{
  "name": "babel-plugin-loxer-trace",
  "version": "0.1.0",
  "description": "Babel instrumentation for Loxer plain-function traces",
  "license": "MIT",
  "author": "Christian Prinz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
